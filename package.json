{
  "name": "fletch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/clean-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "setup:local": "node scripts/setup-local.mjs",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "check:public": "node scripts/check-public-release.mjs",
    "worker:build": "node --conditions=react-server --import tsx workers/build.ts",
    "worker:registry": "node --conditions=react-server --import tsx workers/registry.ts",
    "worker:watch": "node --conditions=react-server --import tsx workers/watch.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.102.8",
    "@types/three": "^0.185.4",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "^5.32.15",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "viem": "^2.56.0",
    "wagmi": "^3.7.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "MIT",
  "description": "Open-source AI app builder with sandboxed tools, EVM contracts, static publishing, registry API and MCP.",
  "engines": {
    "node": ">=22 <25"
  }
}
