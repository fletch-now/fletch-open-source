# Configure a remote executor after reviewing docs/operations/servers.md.
# Supply your own SHA256 host identity after independently verifying that host.
DOCKER_HOST=ssh://fletch-executor
DOCKER_CONFIG=/etc/fletch/docker-client
FORGE_EXECUTOR_SSH=fletch-executor
FORGE_EXECUTOR_HOST_ID=
FORGE_BUILD_EXECUTION=worker
FORGE_AGENT=cli
FORGE_AGENT_BIN=kimi
FORGE_AGENT_SANDBOX=docker
FORGE_AGENT_IMAGE=fletch-agent:latest
FORGE_WORKSPACE_ROOT=/var/lib/fletch/workspaces
FORGE_CHECKPOINT_ROOT=/var/lib/fletch/build-checkpoints
FORGE_SITES_ROOT=/var/lib/fletch/sites
FORGE_PROXY_BIND=172.17.0.1
FORGE_PROXY_PORT=3902
FORGE_AGENT_CPUS=2
FORGE_AGENT_MEMORY=2g
FORGE_SANDBOX_CGROUP_PARENT=fletch-builds.slice
PGPOOL_MAX=20
