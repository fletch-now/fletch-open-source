[Unit]
Description=Back up verified builder checkpoints and idle project source
After=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/fletch/app
ExecStart=/usr/bin/flock --nonblock /run/lock/fletch-source-backup.lock /opt/fletch/app/node_modules/.bin/tsx scripts/fletch-source-backup.mts
UMask=0077
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
