[Unit]
Description=Observe Fletch registry freshness and record transitions
After=postgresql.service

[Service]
Type=oneshot
User=fletch
EnvironmentFile=/etc/fletch/fletch.env
WorkingDirectory=/opt/fletch/app
ExecStart=/opt/fletch/app/node_modules/.bin/tsx workers/registry-observer.ts
TimeoutStartSec=45
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
