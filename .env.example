# Local configuration. Run npm run setup:local to generate a private .env.local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5455/forge
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3400
NEXT_PUBLIC_APP_URL=http://localhost:3400
NEXT_PUBLIC_APP_DOMAIN=localhost:3400
NEXT_PUBLIC_APPS_DOMAIN=apps.example.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Development-only account shortcut. MUST be 0 in production.
FORGE_DEV_LOGIN=1
FORGE_MAINNET_DEPLOYS=0

# Real builds execute only in the sandbox. With no model connection, development
# shows a demo stub; its output is not a real compile, test or deployment.
FORGE_AGENT=cli
FORGE_AGENT_BIN=kimi
FORGE_AGENT_SANDBOX=docker
FORGE_AGENT_IMAGE=fletch-agent:latest
# legacy = single local web process; production should use the independent worker.
FORGE_BUILD_EXECUTION=legacy
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
# OpenAI/Anthropic own-key connections are configured through Settings or gateway.
# Encryption key for hosted own-key storage (at least 32 characters).
MODEL_CREDENTIAL_KEY=
FORGE_WORKSPACE_ROOT=
FORGE_CHECKPOINT_ROOT=
FORGE_SITES_ROOT=
# Independent worker example: use the host's Docker bridge address, reachable from
# containers, with firewall restrictions. See docs/operations/servers.md.
# FORGE_PROXY_BIND=172.17.0.1
# FORGE_PROXY_PORT=3902

# Optional chain providers: server-only. Do not put paid RPC credentials in VITE_*.
ALCHEMY_API_KEY=
RPC_URL_4663=
RPC_URL_46630=
RPC_LOG_URL_4663=
RPC_LOG_URL_46630=
# Disposable funded TESTNET signer only. Never commit a key or mount it in a sandbox.
FORGE_DEPLOYER_KEY_46630=

# Optional operations/integrations. Blank treasury disables credit purchases.
ADMIN_WALLETS=
ADMIN_PASSWORD_HASH=
FLETCH_TREASURY_ADDRESS=
TELEGRAM_BOT_TOKEN=
GOOGLE_SITE_VERIFICATION=
NEXT_TELEMETRY_DISABLED=1
